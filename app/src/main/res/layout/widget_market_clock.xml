<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical"
    android:padding="16dp" android:background="#172C2B">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="CANDLE ALERT • MARKET CLOCK"
        android:textColor="#8ED7C7" android:textSize="11sp" android:textStyle="bold"/>
    <TextClock android:id="@+id/widget_clock" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:format24Hour="HH:mm"
        android:format12Hour="HH:mm" android:textColor="#FFFFFF"
        android:textSize="42sp" android:textStyle="bold" android:includeFontPadding="false"/>
    <TextView android:id="@+id/widget_zone" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Local time"
        android:textColor="#B6C9C4" android:textSize="12sp"/>
</LinearLayout>